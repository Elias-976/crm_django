# ==============================================================================
# CRM Pro - .gitignore (Django / PostgreSQL / Astro / Python / Node / macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environnements Virtuels & Paquets Python
# ------------------------------------------------------------------------------
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Bytecode & Caches Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Django & Base de données locale
# ------------------------------------------------------------------------------
# Base SQLite locale de développement (ne pas versionner)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
db.sqlite3

# Fichiers statiques collectés et médias uploadés
staticfiles/
collected_static/
media/
!media/.gitkeep

# ------------------------------------------------------------------------------
# 4. Variables d'environnement & Secrets (CRITIQUE SÉCURITÉ)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Conserver les modèles d'exemple pour l'équipe
!.env.example
!.env.template

# Certificats & clés privées
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 5. Frontend Astro / Node / Tailwind
# ------------------------------------------------------------------------------
node_modules/
.astro/
dist/
build/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Tests, Qualité de code & Couverture
# ------------------------------------------------------------------------------
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ------------------------------------------------------------------------------
# 7. Système d'exploitation (macOS / Windows / Linux)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 8. Éditeurs & IDEs
# ------------------------------------------------------------------------------
.idea/
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/

# VS Code (ignore le cache et l'état utilisateur, conserve la config projet partagée si besoin)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

